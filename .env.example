# Copy this file to .env and fill in the keys you actually use.
# .env is read at startup; real environment variables take precedence.

# --- OpenRouter (many models behind one key) --------------------------------
OPENROUTER_API_KEY=

# --- OpenCode (Go plan / Zen) ----------------------------------------------
OPENCODE_GO_API_KEY=
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# --- First-party providers --------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Venice (uncensored / private inference) --------------------------------
VENICE_API_KEY=
# VENICE_BASE_URL=https://api.venice.ai/api/v1

# --- Other OpenAI-compatible providers --------------------------------------
PERPLEXITY_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
NOVITA_API_KEY=
NEBIUS_API_KEY=
HYPERBOLIC_API_KEY=
# Used by the `github` model provider AND the GitHub MCP server (mcp.json).
# Classic PAT: repo, read:org, read:user. Fine-grained works for read-only tools.
GITHUB_TOKEN=

# --- Fast / cheap inference -------------------------------------------------
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=

# --- Local servers (no key needed) -----------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Anything else OpenAI-compatible ---------------------------------------
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# --- Defaults (can also live in config.json) -------------------------------
# AGENT_PROVIDER=openrouter
# AGENT_MODEL=anthropic/claude-sonnet-4.5
# AGENT_SHELL=auto            # auto | bash | sh | cmd  (run_command)
# AGENT_BASH=C:\Program Files\Git\bin\bash.exe
